# DataSense AI Configuration

# LLM Provider Selection: "auto", "gemini", "openai", or "groq"
LLM_PROVIDER=auto

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Total deadline for each logical call, including retries (seconds)
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=3
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=4096
# Optional per-process request pacing for bulk runs; 0 disables pacing
GEMINI_REQUESTS_PER_MINUTE=4

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_ATTEMPTS=3
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_REQUESTS_PER_MINUTE=6
# Rolling prompt/output reservation budget; actual usage replaces estimates
GROQ_TOKENS_PER_MINUTE=7000

# DuckDB Settings
DUCKDB_PATH=data/tpch.duckdb
TPCH_SCALE_FACTOR=0.1

# Persistent vector index (relative to the project root, or an absolute path)
CHROMA_STORAGE_PATH=data/chroma_storage
